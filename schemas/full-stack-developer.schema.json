{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/business-manager-cv.schema.json",
  "title": "Business Manager CV",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "summary",
    "highlights",
    "skills",
    "certifications",
    "experience",
    "education",
    "projects"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "location",
        "email",
        "phone",
        "linkedin",
        "website",
        "availability"
      ],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "linkedin": { "type": "string", "format": "uri" },
        "website": { "type": "string", "format": "uri" },
        "availability": { "type": "string" }
      }
    },
    "summary": { "type": "string" },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "items"],
        "properties": {
          "category": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "company", "period", "location", "highlights"],
        "properties": {
          "role": { "type": "string" },
          "company": { "type": "string" },
          "period": { "type": "string" },
          "location": { "type": "string" },
          "employmentType": { "type": "string" },
          "highlights": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["degree", "field", "school", "period"],
        "properties": {
          "degree": { "type": "string" },
          "field": { "type": "string" },
          "school": { "type": "string" },
          "period": { "type": "string" },
          "location": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "summary", "impact"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "summary": { "type": "string" },
          "impact": { "type": "string" }
        }
      }
    }
  }
}
